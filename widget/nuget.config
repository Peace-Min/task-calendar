<?xml version="1.0" encoding="utf-8"?>
<!-- 오프라인(폐쇄망) 빌드 지원:
     local    : 저장소에 동봉한 패키지(nuget-packages/) — 인터넷 없이 WebView2 복원
     nuget.org: 인터넷 가능 시 그 외 패키지(자체포함 런타임 팩 등) 복원
     → SDK만 설치돼 있으면 폐쇄망에서도 프레임워크 종속 빌드가 동작합니다. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="nuget-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
