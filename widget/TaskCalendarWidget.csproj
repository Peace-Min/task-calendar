<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 트레이 아이콘(System.Windows.Forms.NotifyIcon) — 인박스, NuGet 불필요, 오프라인 OK -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- DPI는 app.manifest(PerMonitorV2)로 WPF가 처리 — WinForms 전용 DPI 경고 억제 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TaskCalendarWidget</AssemblyName>
    <RootNamespace>TaskCalendarWidget</RootNamespace>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 폐쇄망: 런타임 다운로드 없이 설치된 .NET 9 Desktop 런타임 사용 (프레임워크 종속) -->
    <SelfContained>false</SelfContained>
    <!-- 최신 패치를 NuGet에서 받지 않고 설치된 런타임/apphost 팩(9.0.17)을 사용 -->
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <RuntimeFrameworkVersion>9.0.17</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- 검증 완료된 단일 HTML 프로토타입을 위젯 본체로 임베드 (단일 소스 유지) -->
    <EmbeddedResource Include="..\task-calendar-prototype.html" Link="index.html" />
  </ItemGroup>

</Project>
